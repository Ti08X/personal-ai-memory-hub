{
  "name": "personal-ai-memory-hub",
  "version": "1.0.0",
  "description": "Cloudflare Workers + D1 personal context and memory service",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "predeploy": "node scripts/build-ui.mjs",
    "deploy": "node scripts/deploy-server.mjs",
    "build:server": "node scripts/build-server.mjs",
    "test:server": "node scripts/test-server.mjs",
    "deploy:cloudflare:legacy": "wrangler deploy --config wrangler.legacy.jsonc --keep-vars",
    "migrate": "wrangler d1 migrations apply personal-ai-memory-hub --local",
    "test:local": "node scripts/test-local.mjs",
    "test:rag": "node --test tests/rag.test.mjs",
    "preview:workbench": "node workbench/scripts/preview.mjs",
    "test:workbench:ui": "node workbench/scripts/verify-ui.cjs",
    "test:workbench:api": "node --test workbench/scripts/api.test.mjs workbench/scripts/intel.test.mjs",
    "test:workbench:live": "node workbench/scripts/verify-live.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0",
    "undici": "^7.29.1",
    "miniflare": "5.20261006.1-alpha"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  }
}
