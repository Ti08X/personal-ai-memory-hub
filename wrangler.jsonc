{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-ai-memory-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-ai-memory-hub",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "REPLACE_WITH_YOUR_VECTOR_INDEX"
    }
  ],
  "vars": {
    "RAG_ENABLED": "false",
    "SUMMARY_BASE_URL": "",
    "SUMMARY_MODEL": ""
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
